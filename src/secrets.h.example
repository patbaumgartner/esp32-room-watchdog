#pragma once

// Copy this file to secrets.h and fill in real values.
// secrets.h is gitignored — never commit real credentials.

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Self-hosted Gotify server + application token (Gotify UI > Apps > token).
// https is validated against the Let's Encrypt root in certs.h. http works but
// sends this token in cleartext across your LAN.
#define GOTIFY_URL    "https://gotify.example.com"
#define GOTIFY_TOKEN  "your-gotify-app-token"

// Shared secret for the LAN HTTP API. It guards live occupancy data and the
// microphone stream, so generate it randomly — the build rejects anything
// shorter than 16 characters. For example:
//   openssl rand -base64 24
#define API_TOKEN     "choose-a-long-random-string"
